[physics]

3d/physics_engine="Jolt Physics"
3d/physics_engine.web="GodotPhysics3D"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=4096.0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4.0
environment/ssao/quality=3.0
environment/ssao/half_size=false
environment/defaults/default_clear_color=Color(0.91, 0.91, 0.89, 1)
