.godot/
*.tmp

# Disposable local checks and captures.
/tmp/
/temp_game/

# Portable local configuration and saves; retain only the import exclusion marker.
/data/*
!/data/.gdignore

# Portable installation/configuration; development sources remain under games/.
/protocols/*
!/protocols/.gdignore
/maingame/*
!/maingame/.gdignore
/minigame/*
!/minigame/.gdignore
/core/config/settings.json
/core/config/settings.json.bak
/core/config/settings.json.pending
/core/config/party_sources.json
/core/config/party_sources.json.bak
/core/config/party_sources.json.pending
/core/saves/
