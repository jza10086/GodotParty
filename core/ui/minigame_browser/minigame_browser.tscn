[node name="MinigameBrowser" type="VBoxContainer"]
theme = ExtResource("ambient")
script = ExtResource("logic")
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Body" parent="." type="HBoxContainer"]
size_flags_vertical = 3
