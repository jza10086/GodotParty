[ext_resource type="Script" path="res://core/ui/source/ui/theme/theme_color_rect.gd" id="color"]
[node name="EventModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 0
