[gd_scene format=3]

[ext_resource type="Script" path="res://core/ui/loading_page.gd" id="script"]
[ext_resource type="Theme" path="res://core/ui/ambient_reveal/ambient_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://core/ui/ambient_reveal/components/background.tscn" id="background"]

[node name="LoadingPage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" parent="." instance=ExtResource("background")]

[node name="Insets" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 96
theme_override_constants/margin_right = 96
theme_override_constants/margin_top = 48
theme_override_constants/margin_bottom = 60

[node name="Content" type="VBoxContainer" parent="Insets"]
layout_mode = 2
mouse_filter = 2
alignment = 2
theme_override_constants/separation = 24

[node name="LoadingText" type="Label" parent="Insets/Content"]
layout_mode = 2
mouse_filter = 2
text = "加载中，请稍后"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28

[node name="Progress" type="ProgressBar" parent="Insets/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
mouse_filter = 2
max_value = 1.0
step = 0.001
show_percentage = true
