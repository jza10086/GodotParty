[gd_scene format=3]
[ext_resource type="Script" path="res://core/ui/settings/setting_section.gd" id="script"]
[ext_resource type="PackedScene" path="res://core/ui/settings/switch_option.tscn" id="toggle"]


[ext_resource type="PackedScene" path="res://core/ui/ambient_reveal/components/card.tscn" id="ar_card"]

[sub_resource type="StyleBoxFlat" id="CardInset"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.10, 0.14, 0.20, 1)
anti_aliasing = false

[node name="SettingSection" type="VBoxContainer"]
theme_override_constants/separation = 14
script = ExtResource("script")
[node name="RowFrame" parent="." instance=ExtResource("ar_card")]
theme_override_styles/panel = SubResource("CardInset")
unique_name_in_owner = true
[node name="Column" type="VBoxContainer" parent="RowFrame"]
theme_override_constants/separation = 0
mouse_filter = 1
[node name="HeaderHit" type="MarginContainer" parent="RowFrame/Column"]
unique_name_in_owner = true
mouse_filter = 0
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12
[node name="Header" type="HBoxContainer" parent="RowFrame/Column/HeaderHit"]
unique_name_in_owner = true
mouse_filter = 1
custom_minimum_size = Vector2(0, 62)
theme_override_constants/separation = 10
[node name="Title" type="Label" parent="RowFrame/Column/HeaderHit/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 52)
size_flags_vertical = 4
text = "设置"
autowrap_mode = 3
vertical_alignment = 1
theme_override_font_sizes/font_size = 28
[node name="Editor" type="VBoxContainer" parent="RowFrame/Column/HeaderHit/Header"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 4
[node name="Summary" type="Label" parent="RowFrame/Column/HeaderHit/Header"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 4
autowrap_mode = 3
vertical_alignment = 1
theme_override_font_sizes/font_size = 24
[node name="Inherit" parent="RowFrame/Column/HeaderHit/Header" instance=ExtResource("toggle")]
unique_name_in_owner = true
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 22
text = "继承协议"
[node name="BodyInset" type="MarginContainer" parent="RowFrame/Column"]
mouse_filter = 1
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
[node name="Clip" type="Control" parent="RowFrame/Column/BodyInset"]
unique_name_in_owner = true
clip_contents = true
mouse_filter = 2
[node name="Padding" type="PanelContainer" parent="RowFrame/Column/BodyInset"]
theme_type_variation = &"FoldBody"
unique_name_in_owner = true
mouse_filter = 1
[node name="Body" type="VBoxContainer" parent="RowFrame/Column/BodyInset/Padding"]
unique_name_in_owner = true
theme_override_constants/separation = 14
