[gd_scene format=3]
[ext_resource type="Script" path="res://core/ui/settings/setting_row.gd" id="script"]
[ext_resource type="Theme" path="res://core/ui/ambient_reveal/ambient_theme.tres" id="theme"]

[ext_resource type="PackedScene" path="res://core/ui/ambient_reveal/components/button.tscn" id="ar_button"]

[ext_resource type="PackedScene" path="res://core/ui/ambient_reveal/components/line_edit.tscn" id="ar_line_edit"]

[ext_resource type="Theme" path="res://core/ui/settings/field_theme.tres" id="field_theme"]

[node name="Setting" type="VBoxContainer"]
theme = ExtResource("theme")
size_flags_horizontal = 3
theme_override_constants/separation = 8
script = ExtResource("script")
[node name="Label" type="Label" parent="."]
unique_name_in_owner = true
text = "设置"
[node name="Controls" type="HBoxContainer" parent="."]
unique_name_in_owner = true
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 56)

[node name="Value" parent="Controls" instance=ExtResource("ar_line_edit")]
theme = ExtResource("field_theme")
unique_name_in_owner = true
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 56)
editable = false
[node name="Browse" parent="Controls" instance=ExtResource("ar_button")]
theme = ExtResource("field_theme")
unique_name_in_owner = true
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 56)
size_flags_horizontal = 0
text = "浏览…"
[node name="Clear" parent="Controls" instance=ExtResource("ar_button")]
theme = ExtResource("field_theme")
unique_name_in_owner = true
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 56)
size_flags_horizontal = 0
text = "清空"
[node name="Picker" type="FileDialog" parent="."]
unique_name_in_owner = true
