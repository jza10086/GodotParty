[gd_scene format=3]

[ext_resource type="Theme" path="res://core/ui/ambient_reveal/ambient_theme.tres" id="theme"]
[ext_resource type="Script" path="res://core/ui/ambient_reveal/components/navigation/xbox_hints.gd" id="logic"]
[ext_resource type="PackedScene" path="res://core/ui/ambient_reveal/components/navigation/action_prompt.tscn" id="prompt"]
[ext_resource type="Texture2D" path="res://core/ui/ambient_reveal/icons/kenney_input/xbox/xbox_dpad.svg" id="dpad"]
[ext_resource type="Texture2D" path="res://core/ui/ambient_reveal/icons/kenney_input/xbox/xbox_stick_l.svg" id="left_stick"]
[ext_resource type="Texture2D" path="res://core/ui/ambient_reveal/icons/kenney_input/xbox/xbox_stick_r.svg" id="right_stick"]
[ext_resource type="Texture2D" path="res://core/ui/ambient_reveal/icons/kenney_input/keyboard_mouse/keyboard_arrows.svg" id="arrows"]

[node name="XboxHints" type="PanelContainer"]
script = ExtResource("logic")
theme = ExtResource("theme")
mouse_filter = 2

[node name="Hints" type="HFlowContainer" parent="."]
mouse_filter = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 8
visible = false

[node name="Title" type="Label" parent="Hints"]
custom_minimum_size = Vector2(0, 40)
vertical_alignment = 1
theme_type_variation = &"AccentLabel"
text = "Xbox 手柄"

[node name="Navigation" parent="Hints" instance=ExtResource("prompt")]
action = &""
description = "移动焦点"
gamepad = true
gamepad_icons = Array[Texture2D]([ExtResource("dpad"), ExtResource("left_stick")])

[node name="RightStick" parent="Hints" instance=ExtResource("prompt")]
action = &""
description = "移动光标"
gamepad = true
gamepad_icons = Array[Texture2D]([ExtResource("right_stick")])

[node name="Accept" parent="Hints" instance=ExtResource("prompt")]
action = &"ui_accept"
description = "确认"
gamepad = true

[node name="Back" parent="Hints" instance=ExtResource("prompt")]
action = &"ui_cancel"
description = "返回"
gamepad = true

[node name="Context" parent="Hints" instance=ExtResource("prompt")]
action = &"ambient_context_menu"
description = "上下文菜单"
gamepad = true

[node name="Home" parent="Hints" instance=ExtResource("prompt")]
action = &"ambient_home"
description = "首个选项"
gamepad = true

[node name="Previous" parent="Hints" instance=ExtResource("prompt")]
action = &"ambient_previous_tab"
description = "上一页"
gamepad = true

[node name="Next" parent="Hints" instance=ExtResource("prompt")]
action = &"ambient_next_tab"
description = "下一页"
gamepad = true

[node name="KeyboardHints" type="HFlowContainer" parent="."]
mouse_filter = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 8

[node name="Title" type="Label" parent="KeyboardHints"]
visible = false
custom_minimum_size = Vector2(0, 40)
vertical_alignment = 1
theme_type_variation = &"AccentLabel"
text = "键盘与鼠标"

[node name="Navigate" parent="KeyboardHints" instance=ExtResource("prompt")]
action = &""
description = "移动焦点"
gamepad = false
keyboard_icons = Array[Texture2D]([ExtResource("arrows")])

[node name="Next" parent="KeyboardHints" instance=ExtResource("prompt")]
action = &"ui_focus_next"
description = "切换焦点"
gamepad = false

[node name="Previous" parent="KeyboardHints" instance=ExtResource("prompt")]
action = &"ui_focus_prev"
description = "反向切换焦点"
gamepad = false

[node name="Accept" parent="KeyboardHints" instance=ExtResource("prompt")]
action = &"ui_accept"
description = "确认"
gamepad = false

[node name="Back" parent="KeyboardHints" instance=ExtResource("prompt")]
action = &"ui_cancel"
description = "返回"
gamepad = false
