[node name="PlayerCard" type="Button"]
custom_minimum_size = Vector2(0, 72)
size_flags_horizontal = 3
theme = ExtResource("theme")
theme_override_styles/normal = SubResource("Normal")
theme_override_styles/hover = SubResource("Hover")
theme_override_styles/pressed = SubResource("Pressed")
theme_override_styles/hover_pressed = SubResource("Pressed")
theme_override_styles/focus = SubResource("Focus")
theme_override_styles/disabled = SubResource("Empty")
script = ExtResource("logic")

[node name="Insets" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_right = 18

[node name="Row" type="HBoxContainer" parent="Insets"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="PlayerName" type="Label" parent="Insets/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
text = "空位"
vertical_alignment = 1
text_overrun_behavior = 3
theme_override_font_sizes/font_size = 24

[node name="PlayerStatus" type="Label" parent="Insets/Row"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
vertical_alignment = 1
theme_override_font_sizes/font_size = 20
