{
  "manifest_version": 2,
  "core_api_major": 4,
  "package_version": "1.0.0",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "entry": "game.tscn",
  "dependencies": {
    "godot_party_default_protocol": "1.0.0"
  },
  "id": "godot_party_default_blank",
  "name": "空白小游戏",
  "kind": "minigame",
  "introduction": "所有参赛者准备后倒计时三秒开局。每人点击一次「结束游戏」，按房主收到点击的先后排名。所有在线参赛者按完后显示本轮结算，退出者不排名。",
  "config_schema": "settings.gd",
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  }
}
