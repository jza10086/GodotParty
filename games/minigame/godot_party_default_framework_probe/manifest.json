{
  "manifest_version": 2,
  "core_api_major": 4,
  "package_version": "1.1.0",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "entry": "game.tscn",
  "dependencies": {
    "godot_party_default_protocol": "1.0.0"
  },
  "id": "godot_party_default_framework_probe",
  "name": "框架测试小游戏",
  "kind": "minigame",
  "introduction": "从房间直接进入，检查技术就绪、参赛身份、通信回执、父游戏请求与普通局结算。连续两轮可在第二轮观察上一轮的清理结果。",
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "config_schema": "settings.gd",
  "streams": {
    "receipt": {
      "mode": "reliable",
      "audience": "instance"
    }
  }
}
