msgid "GodotPartyDefault · 小游戏轮换"
msgstr "GodotPartyDefault · 小游戏轮换"

msgid "避免游戏重复"
msgstr "避免游戏重复"

msgid "0 表示自动按已选小游戏数量设置；大于 0 表示手动局数。"
msgstr "0 表示自动按已选小游戏数量设置；大于 0 表示手动局数。"

msgid "局间间隔（秒）"
msgstr "局间间隔（秒）"

msgid "仅随机轮换生效。开启后每个小游戏最多出现一次，实际局数不超过已选小游戏数。"
msgstr "仅随机轮换生效。开启后每个小游戏最多出现一次，实际局数不超过已选小游戏数。"

msgid "轮换局数"
msgstr "轮换局数"

msgid "游戏规则"
msgstr "游戏规则"

msgid "轮换方式"
msgstr "轮换方式"

msgid "顺序按小游戏列表排列；随机由房主抽取并保存整次队列。"
msgstr "顺序按小游戏列表排列；随机由房主抽取并保存整次队列。"

msgid "默认 0：上一局正式结算后直接加载下一局，无需手动确认。"
msgstr "默认 0：上一局正式结算后直接加载下一局，无需手动确认。"

msgid "按小游戏数量自动设置局数"
msgstr "按小游戏数量自动设置局数"

msgid "高级设置"
msgstr "高级设置"
